# Get this from @BotFather in Telegram. Keep it private.
TELEGRAM_BOT_TOKEN=

# One or more chat IDs, separated by commas. See README for the lookup.
TELEGRAM_CHAT_ID=

# Optional separate bot for one-time Transfermarkt player statistics.
TRANSFERMARKT_BOT_TOKEN=
TRANSFERMARKT_CHAT_ID=

# Check interval in seconds.
CHECK_INTERVAL_SECONDS=45

# Trigger only when the displayed Yes rate is strictly greater than this value.
YES_RATE_THRESHOLD=40

# The AR BET live soccer page to watch.
ARBET_URL=https://inr.arbet.club/live/soccer

# Use false while testing if the site permits normal headless browsing.
HEADLESS=true

# Local dashboard port.
DASHBOARD_PORT=3000

# Optional: path to Chrome or Edge. Leave blank to use installed Edge on Windows.
ARBET_BROWSER_PATH=

# Optional: use true while verifying the scanner without sending Telegram.
DRY_RUN=false
